\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Theoretical layer-fraction recipe counts for endpoint alphabets used in the expanded-gamut analysis.} Counts collapse redundant stack orderings with identical layer fractions. These values describe enumerated design spaces for the listed alphabets, not the number of experimentally distinguishable printed colors or the number of colors used in any single printed triangular gamut.}}{2}{table.1}\protected@file@percent }
\newlabel{tab:supp-theoretical-counts}{{S1}{2}{\textbf {Theoretical layer-fraction recipe counts for endpoint alphabets used in the expanded-gamut analysis.} Counts collapse redundant stack orderings with identical layer fractions. These values describe enumerated design spaces for the listed alphabets, not the number of experimentally distinguishable printed colors or the number of colors used in any single printed triangular gamut}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Measured color coverage summaries.} Measured regions are printed region observations across the corresponding endpoint-substitution gamut samples. Distinguishable counts are connected-component counts after thresholding pairwise CIEDE2000 distances.}}{2}{table.2}\protected@file@percent }
\newlabel{tab:supp-color-summary}{{S2}{2}{\textbf {Measured color coverage summaries.} Measured regions are printed region observations across the corresponding endpoint-substitution gamut samples. Distinguishable counts are connected-component counts after thresholding pairwise CIEDE2000 distances}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Nine-cube benchmark values.} Bambu X1C and Snapmaker U1 values are measured. Prusa XL values are slicer estimates.}}{2}{table.3}\protected@file@percent }
\newlabel{tab:supp-benchmark-values}{{S3}{2}{\textbf {Nine-cube benchmark values.} Bambu X1C and Snapmaker U1 values are measured. Prusa XL values are slicer estimates}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Repeatability checks for calibrated photographic measurements.} Duplicate photographs of the same printed gamut were independently processed and compared region by region. Values shown are CIEDE2000 distances between duplicate measurements.}}{3}{table.4}\protected@file@percent }
\newlabel{tab:supp-repeatability}{{S4}{3}{\textbf {Repeatability checks for calibrated photographic measurements.} Duplicate photographs of the same printed gamut were independently processed and compared region by region. Values shown are CIEDE2000 distances between duplicate measurements}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces \textbf  {Filaments used for printed color endpoints.} All entries are commercially available PLA filaments. Bambu Lab entries were PLA Basic unless otherwise noted. Exact catalog names or SKUs were not recorded for every Bambu Lab endpoint color.}}{3}{table.5}\protected@file@percent }
\newlabel{tab:supp-filaments}{{S5}{3}{\textbf {Filaments used for printed color endpoints.} All entries are commercially available PLA filaments. Bambu Lab entries were PLA Basic unless otherwise noted. Exact catalog names or SKUs were not recorded for every Bambu Lab endpoint color}{table.5}{}}
